{
  "name": "angular-interface-to-io",
  "displayName": "Angular-interface-to-io",
  "description": "Automatizate makeing input and output functions of your types (interfaces).",
  "version": "1.0.0",
  "publisher": "GZGTeam", 
  "icon": "./public/i2ioLogo.jpg",
  "author": "Timur Khen",
  "license": "MIT",
  "keywords": [
    "angular",
    "interface",
    "input",
    "output",
    "generator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/<ваш-логин>/<ваш-репозиторий>.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "angular-interface-to-io.generateInput",
        "title": "transform interface to input",
        "icon": {
          "light": "./public/i2ioLogo.jpg",
          "dark": "./public/i2ioLogo.jpg"
        }
      },
      {
        "command": "angular-interface-to-io.generateOutput",
        "title": "transform interface to output",
        "icon": {
          "light": "./public/i2ioLogo.jpg",
          "dark": "./public/i2ioLogo.jpg"
        }
      }
    ],
    "submenus": [
      {
        "id": "angular-interface-to-io.ioMenu",
        "label": "Angular: I2IO",
        "icon": {
          "light": "./public/i2ioLogo.jpg",
          "dark": "./public/i2ioLogo.jpg"
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "angular-interface-to-io.ioMenu",
          "group": "1_modification"
        }
      ],
      "angular-interface-to-io.ioMenu": [
        {
          "command": "angular-interface-to-io.generateInput",
          "group": "1_actions@1"
        },
        {
          "command": "angular-interface-to-io.generateOutput",
          "group": "1_actions@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}